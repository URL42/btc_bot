TELEGRAM_BOT_TOKEN=YYYYYY
TELEGRAM_CHAT_ID=ZZZZZ

# LLM provider: openai | deepseek | ollama  (override per run with --provider / --model)
LLM_PROVIDER=openai
OPENAI_API_KEY=XXXXX
# OPENAI_MODEL=gpt-4.1

# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat          # or deepseek-reasoner

# OLLAMA_BASE_URL=http://localhost:11434  # inside Docker use http://host.docker.internal:11434 or a LAN IP
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_THINK=false                       # true = slower reasoning mode for thinking models
# OLLAMA_NUM_CTX=16384

# LLM_TEMPERATURE=0
# BUY_THRESHOLD=60                         # P(up in 7d) >= this -> BUY
# AVOID_THRESHOLD=40                       # P(up in 7d) <= this -> AVOID
